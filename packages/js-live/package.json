{
  "name": "@pieceful/ravel-js-live",
  "version": "0.2.0",
  "type": "module",
  "description": "QuickJS/Wasm live JavaScript provider for Ravel.",
  "license": "MIT",
  "author": "James Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jostylr/ravel.git",
    "directory": "packages/js-live"
  },
  "bugs": {
    "url": "https://github.com/jostylr/ravel/issues"
  },
  "homepage": "https://ravel.jostylr.com/",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ravel",
    "quickjs",
    "webassembly",
    "sandbox",
    "live-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    },
    "./worker-browser": {
      "types": "./src/worker-browser.d.ts",
      "default": "./src/worker-browser.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "acorn": "8.17.0",
    "esbuild": "0.28.1",
    "quickjs-emscripten": "0.32.0"
  },
  "peerDependencies": {
    "@pieceful/ravel-core": "0.2.0"
  }
}
