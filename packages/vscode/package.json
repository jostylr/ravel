{
  "name": "@pieceful/ravel-vscode",
  "displayName": "Ravel Explorer",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Experimental VS Code host for the source-linked Ravel Explorer.",
  "license": "MIT",
  "author": "James Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jostylr/ravel.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:ravel.openExplorer",
    "workspaceContains:**/ravel.toml",
    "onLanguage:markdown",
    "onLanguage:quarto",
    "onLanguage:org",
    "onLanguage:asciidoc",
    "onLanguage:html"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "ravel.openExplorer",
        "title": "Ravel: Open Explorer",
        "category": "Ravel"
      },
      {
        "command": "ravel.openGenerated",
        "title": "Ravel: Open Generated Occurrence",
        "category": "Ravel"
      },
      {
        "command": "ravel.nextGeneratedOccurrence",
        "title": "Ravel: Next Generated Occurrence",
        "category": "Ravel"
      },
      {
        "command": "ravel.previousGeneratedOccurrence",
        "title": "Ravel: Previous Generated Occurrence",
        "category": "Ravel"
      },
      {
        "command": "ravel.returnToSource",
        "title": "Ravel: Return from Generated Code to Source",
        "category": "Ravel"
      },
      {
        "command": "ravel.selectTarget",
        "title": "Ravel: Select Analysis Target",
        "category": "Ravel"
      }
    ],
    "configuration": {
      "title": "Ravel",
      "properties": {
        "ravel.defaultTarget": {
          "type": "string",
          "default": "",
          "description": "Default generated target used for target-language analysis when more than one target applies."
        },
        "ravel.javascriptDiagnostics": {
          "type": "string",
          "enum": [
            "all",
            "syntax",
            "off"
          ],
          "enumDescriptions": [
            "Report syntax, type, suggestion, configuration, and compiler-option diagnostics.",
            "Report syntax, configuration, and compiler-option diagnostics, but suppress type and suggestion diagnostics.",
            "Do not report target-language diagnostics for JavaScript fences."
          ],
          "default": "all",
          "scope": "resource",
          "description": "Controls target-language diagnostics for JavaScript and JavaScript React fences. IntelliSense features remain enabled in every mode."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs && esbuild src/webview.js --bundle --platform=browser --format=esm --outfile=dist/webview.mjs && node ../../scripts/copy-typescript-libs.mjs"
  },
  "dependencies": {
    "@pieceful/ravel-core": "0.1.1",
    "@pieceful/ravel-explorer": "0.1.1",
    "@pieceful/ravel-host-node": "0.1.1",
    "@pieceful/ravel-language-service": "0.1.1",
    "@pieceful/ravel-language-typescript": "0.1.1",
    "@pieceful/ravel-projection": "0.1.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "media",
    "README.md",
    "LICENSE"
  ]
}
