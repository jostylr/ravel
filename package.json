{
  "name": "ravel",
  "version": "0.0.0",
  "private": true,
  "description": "A source-mapped literate programming engine for weaving and unraveling programs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:node",
    "test:node": "node --test",
    "test:bun": "bun test",
    "validate:schema": "node scripts/validate-map-example.mjs",
    "build:browser-test": "esbuild browser-test/source/markdown-adapter-entry.mjs --bundle --format=esm --platform=browser --outfile=browser-test/generated/markdown-adapter.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
