{
  "name": "ravel",
  "version": "0.1.0",
  "private": true,
  "description": "A source-mapped literate programming engine for weaving and unraveling programs.",
  "license": "MIT",
  "author": "James Taylor",
  "repository": { "type": "git", "url": "git+https://github.com/jostylr/ravel.git" },
  "bugs": { "url": "https://github.com/jostylr/ravel/issues" },
  "homepage": "https://github.com/jostylr/ravel#readme",
  "keywords": ["literate-programming", "document-composition", "code-generation", "weaving"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:node",
    "test:node": "node --test",
    "test:bun": "bun test",
    "ravel": "node packages/cli/src/index.js",
    "benchmark:assembly": "node examples/benchmark/benchmark-build.mjs",
    "validate:schema": "node scripts/validate-map-example.mjs",
    "build:browser-test": "esbuild browser-test/source/markdown-adapter-entry.mjs --bundle --format=esm --platform=browser --outfile=browser-test/generated/markdown-adapter.mjs",
    "test:pack": "node scripts/packed-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
